# Copy to `.env` and adjust. Compose reads this file automatically.

# Public origin baked into canonical URLs, sitemap, RSS and structured data.
# Must match the URL users actually visit (scheme + host, no trailing slash).
SITE_URL=https://java-guru.dev

# Host interface/port the container publishes on.
# 127.0.0.1 keeps the site private to the host's reverse proxy (recommended).
# Use 0.0.0.0 only if this container is the public edge.
BIND_ADDR=127.0.0.1
PORT=8080
