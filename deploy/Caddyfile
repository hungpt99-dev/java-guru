# Caddy configuration for the java-guru container.
#
# The container listens on 8080 as a non-root user and speaks plain HTTP: TLS is
# expected to be terminated by whatever reverse proxy already runs on the host
# (see docs/deployment.md). If this container is the public edge, drop the
# `auto_https off` line and replace `:8080` with your domain — Caddy will then
# obtain and renew certificates by itself.

{
	auto_https off
	admin off
	servers {
		protocols h1 h2
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	# Legacy single-language URLs (pre /en/) keep working and point at English.
	@legacy path /posts /posts/* /categories /categories/* /tags /tags/* \
		/archives /archives/* /about /about/* /projects /projects/* \
		/homelab /homelab/* /search /search/* /rss.xml
	redir @legacy /en{uri} permanent

	# Static build: directories carry an index.html, clean URLs have no extension.
	try_files {path} {path}/ {path}/index.html

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Immutable, content-hashed build assets and self-hosted fonts.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Search index is rebuilt on deploy; keep it fresh but cacheable.
	@pagefind path /pagefind/*
	header @pagefind Cache-Control "public, max-age=3600"

	# HTML should revalidate so a deploy is visible immediately.
	@html path / *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header /rss.xml Cache-Control "public, max-age=1800"
	header /sitemap*.xml Cache-Control "public, max-age=1800"

	file_server

	# Liveness probe for docker/compose health checks.
	handle /healthz {
		respond "ok" 200
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
