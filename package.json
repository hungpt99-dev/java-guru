{
  "name": "java-guru",
  "version": "2.0.0",
  "type": "module",
  "private": false,
  "description": "Personal engineering journal — backend, distributed systems, Java/JVM, security and AI.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "check": "astro check",
    "type-check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "node scripts/migration/fetch.mjs && node scripts/migration/migrate.mjs && node scripts/migration/validate.mjs",
    "migrate:build": "node scripts/migration/migrate.mjs && node scripts/migration/validate.mjs",
    "fonts": "node scripts/fonts.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.70.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.16.5",
    "katex": "^0.16.25",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "shiki": "^3.19.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/hast": "^3.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pagefind": "^1.6.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
