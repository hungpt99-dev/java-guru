---
import { Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import { ArrowUpRight, ListOrdered } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TableOfContents from "@/components/article/TableOfContents.astro";
import ShareBar from "@/components/article/ShareBar.astro";
import PrevNext from "@/components/article/PrevNext.astro";
import PostCard from "@/components/blog/PostCard.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import type { Post } from "@/utils/posts";
import { postHref, postTags, adjacentPosts, relatedPosts } from "@/utils/posts";
import { categoryByKey, categoryLabel, categoryAccent } from "@/data/categories";
import { formatLongDate, isoDate, localePath } from "@/utils/i18n";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/ui";
import { LOCALE_META, otherLocale, type Locale } from "@/i18n/config";

export interface Props {
  post: Post;
  headings: MarkdownHeading[];
  locale: Locale;
  localePosts: Post[];
  /** Sibling translation, when it exists. */
  translation?: Post;
}

const { post, headings, locale, localePosts, translation } = Astro.props;
const { data } = post;
const t = useTranslations(locale);
const accent = categoryAccent(data.category);
const categorySlug = categoryByKey(data.category)?.slug ?? "";
const category = categoryLabel(data.category, locale);
const tags = postTags(post);
const href = postHref(post);
const canonical = new URL(href, Astro.site ?? SITE.url).href;
const { newer, older } = adjacentPosts(post, localePosts);
const related = relatedPosts(post, localePosts, 3);
const coverUrl = data.coverImage
  ? new URL(data.coverImage.src, Astro.site ?? SITE.url).href
  : undefined;
const route = `/posts/${data.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: SITE.author.name,
    alternateName: SITE.author.handle,
    url: new URL(SITE.url).href,
  },
  publisher: { "@type": "Organization", name: SITE.title, url: new URL(SITE.url).href },
  ...(coverUrl ? { image: [coverUrl] } : {}),
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: canonical,
  inLanguage: LOCALE_META[locale].htmlLang,
  articleSection: category,
  ...(data.tags.length ? { keywords: data.tags.join(", ") } : {}),
  ...(data.readingTime ? { timeRequired: `PT${data.readingTime}M` } : {}),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  locale={locale}
  image={coverUrl}
  type="article"
  publishedTime={data.pubDate}
  section={category}
  tags={data.tags}
  jsonLd={jsonLd}
  route={route}
>
  <div class="progress" data-progress aria-hidden="true"></div>

  <article class="shell pt-8 pb-16" data-article data-line-numbers="off">
    <div class="mx-auto max-w-[62.5rem]">
      <nav
        class="text-subtle mb-8 flex flex-wrap items-center gap-2 font-mono text-[0.65rem]"
        aria-label="Breadcrumb"
      >
        <a href={localePath(locale, "/")} class="hover:text-primary">{t("nav.journal")}</a>
        <span aria-hidden="true">/</span>
        <a href={localePath(locale, "/posts/")} class="hover:text-primary">{t("posts.title")}</a>
        <span aria-hidden="true">/</span>
        <a
          href={localePath(locale, `/categories/${categorySlug}/`)}
          class="text-primary/80 hover:text-primary"
        >
          {category.toLowerCase()}
        </a>
      </nav>

      <header>
        <div class="sr-only" aria-hidden="true">
          <span data-pagefind-filter="locale">{locale}</span>
          <span data-pagefind-filter="category">{category}</span>
          <span data-pagefind-meta="category">{category}</span>
          <span data-pagefind-meta="date">{isoDate(data.pubDate)}</span>
          <span data-pagefind-meta="lang">{locale}</span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href={localePath(locale, `/categories/${categorySlug}/`)}
            class:list={["chip", `cat-${accent}`]}
          >
            {category}
          </a>
          {data.series && <span class="chip chip--neutral">{data.series}</span>}
          {
            translation && (
              <a
                href={postHref(translation)}
                class="chip chip--neutral chip--sm"
                hreflang={translation.data.locale}
                aria-label={t("nav.switchTo", {
                  language: LOCALE_META[translation.data.locale].label,
                })}
              >
                {LOCALE_META[translation.data.locale].short}
                <ArrowUpRight size={10} stroke-width={2} />
              </a>
            )
          }
        </div>

        <h1
          class="font-display mt-5 text-[clamp(1.85rem,4.6vw,2.9rem)] leading-[1.08] font-bold tracking-[-0.03em] text-balance"
          lang={locale}
          data-pagefind-meta="title"
        >
          {data.title}
        </h1>

        <div
          class="text-subtle mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.68rem]"
        >
          <time datetime={isoDate(data.pubDate)} class="text-muted">
            {formatLongDate(data.pubDate, locale)}
          </time>
          <span aria-hidden="true" class="opacity-40">·</span>
          <span>{t("common.readingTime", { minutes: data.readingTime ?? 5 })}</span>
          <span aria-hidden="true" class="opacity-40">·</span>
          <span>{SITE.author.name}</span>
        </div>
      </header>

      {
        data.coverImage && (
          <figure class="mt-9">
            <Image
              src={data.coverImage}
              alt=""
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1024px) 704px, 92vw"
              loading="eager"
              fetchpriority="high"
              class="border-line w-full rounded-xl border"
            />
          </figure>
        )
      }

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-14">
        <div class="min-w-0">
          <TableOfContents headings={headings} locale={locale} variant="mobile" />

          <div class="prose-jg" data-article-body lang={locale} data-pagefind-body>
            <span class="sr-only">{data.description}</span>
            <slot />
          </div>

          {
            tags.length > 0 && (
              <div class="border-line mt-10 flex flex-wrap items-center gap-2 border-t pt-6">
                <span class="label-mono mr-1">{t("article.tags")}</span>
                {tags.map((tag) => (
                  <a
                    href={localePath(locale, `/tags/${tag.slug}/`)}
                    class="chip chip--neutral chip--sm"
                  >
                    #{tag.name}
                  </a>
                ))}
              </div>
            )
          }

          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <ShareBar title={data.title} url={canonical} locale={locale} />
            <button
              type="button"
              class="btn !min-h-8 !px-2.5 !text-[0.65rem]"
              data-line-toggle
              aria-pressed="false"
              data-label-on={t("article.lineNumbers")}
              data-label-off={t("article.hideNumbers")}
            >
              <ListOrdered size={12} stroke-width={2} />
              <span data-line-label>{t("article.lineNumbers")}</span>
            </button>
          </div>

          {
            translation && (
              <p class="border-line bg-sunken/40 text-subtle mt-8 flex flex-wrap items-center gap-2 rounded-lg border p-3.5 font-mono text-[0.65rem]">
                <span>
                  {t("article.translationNote", {
                    language: LOCALE_META[otherLocale(locale)].label,
                  })}
                </span>
                <a href={postHref(translation)} class="link" hreflang={translation.data.locale}>
                  {LOCALE_META[otherLocale(locale)].label} →
                </a>
              </p>
            )
          }

          <PrevNext newer={newer} older={older} locale={locale} />
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8">
            <TableOfContents headings={headings} locale={locale} />
          </div>
        </aside>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="border-line mt-20 border-t pt-10">
          <SectionHeader
            index="—"
            label={t("article.keepReading")}
            title={t("article.related")}
            href={localePath(locale, "/posts/")}
            linkLabel={t("common.all")}
          />
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((entry) => (
              <PostCard post={entry} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  const article = document.querySelector<HTMLElement>("[data-article]");
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  const body = document.querySelector<HTMLElement>("[data-article-body]");

  if (article && bar && body) {
    const update = () => {
      const start = body.offsetTop - 120;
      const end = start + body.offsetHeight - window.innerHeight * 0.55;
      const ratio = (window.scrollY - start) / Math.max(1, end - start);
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const figure = button.closest("figure");
      const code = figure?.querySelector("pre code");
      if (!code) return;
      const original = button.textContent ?? "copy";
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.dataset.copied = "true";
        button.textContent = "copied";
        setTimeout(() => {
          button.dataset.copied = "false";
          button.textContent = original;
        }, 1600);
      } catch {
        button.textContent = "ctrl+c";
      }
    });
  }

  const lineToggle = document.querySelector<HTMLButtonElement>("[data-line-toggle]");
  lineToggle?.addEventListener("click", () => {
    if (!article) return;
    const on = article.dataset.lineNumbers === "on";
    article.dataset.lineNumbers = on ? "off" : "on";
    lineToggle.setAttribute("aria-pressed", String(!on));
    const label = lineToggle.querySelector("[data-line-label]");
    const next = on ? lineToggle.dataset.labelOn : lineToggle.dataset.labelOff;
    if (label && next) label.textContent = next;
  });

  const diagrams = [...document.querySelectorAll<HTMLElement>("[data-mermaid]")];
  if (diagrams.length) {
    import("mermaid")
      .then(async ({ default: mermaid }) => {
        const styles = getComputedStyle(document.documentElement);
        const theme = document.documentElement.dataset.theme;
        mermaid.initialize({
          startOnLoad: false,
          theme: theme === "daylight" ? "default" : "dark",
          fontFamily: styles.getPropertyValue("--font-sans") || "Inter, sans-serif",
          themeVariables: {
            primaryColor: styles.getPropertyValue("--bg-elev").trim(),
            primaryTextColor: styles.getPropertyValue("--fg").trim(),
            lineColor: styles.getPropertyValue("--border-strong").trim(),
          },
        });
        for (const node of diagrams) {
          const source = node.textContent ?? "";
          try {
            const { svg } = await mermaid.render(
              `m-${Math.random().toString(36).slice(2, 8)}`,
              source
            );
            node.innerHTML = svg;
            node.dataset.rendered = "true";
          } catch {
            node.dataset.rendered = "false";
          }
        }
      })
      .catch(() => {
        /* offline or blocked: the raw diagram source stays visible */
      });
  }
</script>
