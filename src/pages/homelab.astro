---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PlaceholderBox from "@/components/common/PlaceholderBox.astro";
import {
  ArrowUpRight,
  Server,
  Network,
  Boxes,
  ShieldCheck,
  Activity,
  DatabaseBackup,
} from "@lucide/astro";
import { getPosts } from "@/utils/posts";
import { SITE } from "@/config";

const posts = await getPosts();
const buildLog = posts.find((p) => p.data.category === "DevOps & Infrastructure");

const sections = [
  {
    id: "infrastructure",
    icon: Server,
    title: "Infrastructure",
    body: "One Ubuntu VPS runs the whole lab. Everything below lives on it as containers or system services, and nothing is exposed that does not need to be.",
    placeholder: {
      label: "host & sizing",
      note: "CPU, RAM, disk and provider are not documented yet.",
    },
  },
  {
    id: "networking",
    icon: Network,
    title: "Networking",
    body: "A single public entry point in front of the internal services, with TLS terminated at the edge.",
    placeholder: {
      label: "proxy & DNS",
      note: "Reverse proxy choice, domains and internal network layout to be documented.",
    },
  },
  {
    id: "services",
    icon: Boxes,
    title: "Services",
    body: "Self-hosted tools for notes, files, dashboards and experiments — the reason the lab exists in the first place.",
    placeholder: {
      label: "service inventory",
      note: "Each service, why it is there and how it is updated will be listed here.",
    },
  },
  {
    id: "security",
    icon: ShieldCheck,
    title: "Security",
    body: "Least-privilege access, key-only SSH, a default-deny firewall and a deliberately small attack surface.",
    placeholder: {
      label: "hardening record",
      note: "Firewall rules, fail2ban policy and audit results pending.",
    },
  },
  {
    id: "monitoring",
    icon: Activity,
    title: "Monitoring",
    body: "Uptime and resource visibility so a failing container is noticed before a user reports it.",
    placeholder: {
      label: "metrics & alerts",
      note: "Stack choice and alert routing not documented yet.",
    },
  },
  {
    id: "backups",
    icon: DatabaseBackup,
    title: "Backups",
    body: "If it is worth self-hosting, it is worth restoring. Backups are only counted when a restore has been tested.",
    placeholder: {
      label: "backup matrix",
      note: "What is backed up, where it goes and the last successful restore test.",
    },
  },
];
---

<BaseLayout
  title="Homelab"
  description="Notes from a self-hosted Ubuntu VPS lab: infrastructure, networking, services, security, monitoring and backups — documented as it is built."
>
  <section class="shell pt-12 pb-8 md:pt-16">
    <p class="eyebrow">Homelab</p>
    <h1 class="display-lg mt-4 max-w-[28ch]">
      A small VPS lab,<br /><span class="text-muted">documented honestly.</span>
    </h1>
    <p class="text-muted mt-4 max-w-[42rem] text-[0.95rem] leading-relaxed">
      This page documents the Ubuntu VPS I use to self-host services and explore infrastructure. It
      is a working document: anything not yet verified is explicitly marked as a placeholder rather
      than invented to look complete.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="chip chip--neutral">Ubuntu VPS</span>
      <span class="chip chip--neutral">self-hosted</span>
      <span class="chip chip--neutral">containers</span>
      {buildLog && <span class="chip cat-devops">build log available</span>}
    </div>
  </section>

  <section class="shell pb-12">
    <div class="grid gap-4 md:grid-cols-2">
      {
        sections.map((section) => {
          const Icon = section.icon;
          return (
            <article id={section.id} class="panel flex flex-col gap-3 p-5">
              <div class="flex items-center gap-2.5">
                <span class="border-line bg-sunken grid h-7 w-7 place-items-center rounded-md border">
                  <Icon size={14} stroke-width={1.75} class="text-primary" />
                </span>
                <h2 class="font-display text-[1.08rem] font-semibold tracking-[-0.01em]">
                  {section.title}
                </h2>
              </div>
              <p class="text-muted text-[0.88rem] leading-relaxed">{section.body}</p>
              <div class="mt-auto pt-1">
                <PlaceholderBox label={section.placeholder.label} note={section.placeholder.note} />
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="shell pb-16">
    <div class="panel overflow-hidden">
      <div class="border-line flex flex-wrap items-center justify-between gap-3 border-b px-5 py-3">
        <p class="label-mono">Architecture</p>
        <p class="text-subtle font-mono text-[0.6rem]">diagram pending</p>
      </div>
      <div class="p-5">
        <PlaceholderBox
          label="topology diagram"
          note="The real diagram (edge → proxy → services → data) will be drawn from the actual setup. Mermaid rendering is already wired into the article pipeline."
        />
      </div>
    </div>

    {
      buildLog && (
        <div class="panel mt-6 flex flex-wrap items-center justify-between gap-4 p-5">
          <div>
            <p class="label-mono mb-1">Read the build log</p>
            <a
              href={`/posts/${buildLog.id}`}
              class="font-display hover:text-primary text-lg font-semibold"
            >
              {buildLog.data.title}
            </a>
          </div>
          <a href={`/posts/${buildLog.id}`} class="btn">
            Open article
            <ArrowUpRight size={12} stroke-width={2} />
          </a>
        </div>
      )
    }

    <p class="text-subtle mt-6 font-mono text-[0.65rem] leading-relaxed">
      The lab runs on infrastructure owned by {SITE.author.name}. Nothing on this page is a template
      for your own — but the build log is written so it can be copied.
    </p>
  </section>
</BaseLayout>
