---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/blog/PostRow.astro";
import Pagination from "@/components/navigation/Pagination.astro";
import { Search } from "@lucide/astro";
import { SITE } from "@/config";
import { getPosts, getCategories, getTags } from "@/utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const allPosts = await getPosts();
const categories = getCategories(allPosts);
const tags = getTags(allPosts).slice(0, 14);
const featured = allPosts.filter((p) => p.data.featured).slice(0, 1)[0];

const offset = (page.currentPage - 1) * SITE.postsPerPage;
---

<BaseLayout
  title="Journal"
  description={`Every article on ${SITE.title} — ${allPosts.length} essays on backend engineering, distributed systems, Java and the JVM, security and AI.`}
>
  <section class="shell pt-12 pb-6 md:pt-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">The journal</p>
        <h1 class="display-lg mt-4">
          {allPosts.length} essays,<br class="hidden sm:block" />
          <span class="text-muted">mostly about systems.</span>
        </h1>
        <p class="text-muted mt-4 max-w-[38rem] text-[0.95rem] leading-relaxed">
          Written in Vietnamese, migrated unchanged from Viblo. Filter by topic or tag, or search
          the full text index.
        </p>
      </div>

      <button type="button" class="btn" data-search-open>
        <Search size={14} stroke-width={1.75} />
        Search the journal
        <span class="text-subtle ml-1 font-mono text-[0.6rem]">⌘K</span>
      </button>
    </div>

    <div class="mt-8 space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="label-mono mr-1">Topic</span>
        <a href="/posts" class="chip" aria-current="page">all</a>
        {
          categories.map((category) => (
            <a
              href={`/categories/${category.slug}`}
              class:list={["chip", `cat-${category.accent}`]}
            >
              {category.name}
              <span class="opacity-60">{category.count}</span>
            </a>
          ))
        }
      </div>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span class="label-mono mr-1">Tag</span>
        {
          tags.map((tag) => (
            <a
              href={`/tags/${tag.slug}`}
              class="text-subtle hover:text-primary font-mono text-[0.68rem] transition-colors"
            >
              #{tag.name}
            </a>
          ))
        }
        <a href="/tags" class="text-primary/80 hover:text-primary font-mono text-[0.68rem]"
          >all tags →</a
        >
      </div>
    </div>
  </section>

  <section class="shell pb-16">
    <div class="border-line mt-6 flex items-center justify-between border-b pb-2">
      <p class="label-mono">
        {
          page.currentPage === 1
            ? `latest ${page.data.length}`
            : `page ${page.currentPage} of ${page.lastPage}`
        }
      </p>
      <p class="label-mono">{allPosts.length} total</p>
    </div>

    <div class="border-line border-b">
      {page.data.map((post, i) => <PostRow post={post} index={offset + i} />)}
    </div>

    <Pagination current={page.currentPage} total={page.lastPage} base="/posts" />

    {
      featured && page.currentPage === 1 && (
        <aside class="border-line bg-sunken/50 mt-10 rounded-xl border p-5">
          <p class="label-mono mb-2">Start here</p>
          <a
            href={`/posts/${featured.id}`}
            class="font-display hover:text-primary text-lg font-semibold"
          >
            {featured.data.title}
          </a>
          <p class="text-muted mt-1.5 line-clamp-2 text-sm">{featured.data.description}</p>
        </aside>
      )
    }
  </section>
</BaseLayout>
