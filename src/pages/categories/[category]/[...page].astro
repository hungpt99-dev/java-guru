---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/blog/PostRow.astro";
import Pagination from "@/components/navigation/Pagination.astro";
import { getPosts, getCategories, postsByCategory, getTags } from "@/utils/posts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const categories = getCategories(posts);
  return categories.flatMap((category) =>
    paginate(postsByCategory(posts, category.slug), {
      params: { category: category.slug },
      props: { category },
      pageSize: SITE.postsPerPage,
    })
  );
}) satisfies GetStaticPaths;

const { category, page } = Astro.props as {
  category: { name: string; slug: string; count: number; accent: string; blurb: string };
  page: Page<Awaited<ReturnType<typeof getPosts>>[number]>;
};

const allPosts = await getPosts();
const tags = getTags(allPosts).slice(0, 10);
const offset = (page.currentPage - 1) * SITE.postsPerPage;
---

<BaseLayout
  title={category.name}
  description={`${category.count} articles on ${category.name} — ${category.blurb}`}
>
  <section class:list={["shell pt-12 pb-8 md:pt-16", `cat-${category.accent}`]}>
    <nav
      class="text-subtle mb-6 flex items-center gap-2 font-mono text-[0.65rem]"
      aria-label="Breadcrumb"
    >
      <a href="/" class="hover:text-primary">home</a>
      <span aria-hidden="true">/</span>
      <a href="/categories" class="hover:text-primary">topics</a>
    </nav>

    <p class="eyebrow">Topic · {String(category.count).padStart(2, "0")} articles</p>
    <h1 class="display-lg mt-4">{category.name}</h1>
    <p class="text-muted mt-3 max-w-[36rem] text-[0.95rem] leading-relaxed">{category.blurb}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1.5">
      <span class="label-mono mr-1">Also tagged</span>
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.slug}`}
            class="text-subtle hover:text-primary font-mono text-[0.68rem]"
          >
            #{tag.name}
          </a>
        ))
      }
    </div>
  </section>

  <section class="shell pb-16">
    <div class="border-line flex items-center justify-between border-b pb-2">
      <p class="label-mono">
        {page.currentPage === 1 ? "newest first" : `page ${page.currentPage} of ${page.lastPage}`}
      </p>
      <a href="/posts" class="label-mono hover:text-primary">all articles →</a>
    </div>

    <div class="border-line border-b">
      {page.data.map((post, i) => <PostRow post={post} index={offset + i} />)}
    </div>

    <Pagination
      current={page.currentPage}
      total={page.lastPage}
      base={`/categories/${category.slug}`}
    />
  </section>
</BaseLayout>
