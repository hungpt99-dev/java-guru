---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight } from "@lucide/astro";
import { getPosts, getCategories, getTags } from "@/utils/posts";
import { formatDate } from "@/utils/slug";
import { SITE } from "@/config";

const posts = await getPosts();
const categories = getCategories(posts);
const tags = getTags(posts);

/** Most frequent original tags inside one category — no invented taxonomy. */
function leadingTags(categoryName: string, limit = 4): string[] {
  const counts = new Map<string, number>();
  for (const post of posts.filter((p) => p.data.category === categoryName)) {
    for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, limit)
    .map(([name]) => name);
}

function latestIn(categoryName: string) {
  return posts.filter((p) => p.data.category === categoryName)[0];
}
---

<BaseLayout
  title="Topics"
  description={`${categories.length} topics on ${SITE.title}: Java and the JVM, system design, microservices, distributed systems, AI agents, security and infrastructure.`}
>
  <section class="shell pt-12 pb-10 md:pt-16">
    <p class="eyebrow">Topics</p>
    <h1 class="display-lg mt-4 max-w-[24ch]">
      Nine threads,<br /><span class="text-muted">one engineering practice.</span>
    </h1>
    <p class="text-muted mt-4 max-w-[40rem] text-[0.95rem] leading-relaxed">
      Every article is filed under the topic it is actually about. Counts are live — they come from
      the migrated collection itself.
    </p>
  </section>

  <section class="shell pb-16">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        categories.map((category) => (
          <article class:list={["panel relative overflow-hidden p-5", `cat-${category.accent}`]}>
            <div class="absolute inset-x-0 top-0 h-0.5 bg-[var(--chip-color)] opacity-60" />
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="font-display text-xl font-semibold tracking-[-0.02em]">
                <a
                  href={`/categories/${category.slug}`}
                  class="hover:text-primary after:absolute after:inset-0"
                >
                  {category.name}
                </a>
              </h2>
              <span class="text-subtle font-mono text-[0.62rem]">
                {String(category.count).padStart(2, "0")}
              </span>
            </div>
            <p class="text-muted mt-2 text-[0.88rem] leading-relaxed">{category.blurb}</p>
            <div class="text-subtle mt-4 flex flex-wrap items-center gap-2 font-mono text-[0.62rem]">
              {leadingTags(category.name).map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
            <p class="border-line text-subtle mt-3 border-t pt-3 font-mono text-[0.62rem]">
              {latestIn(category.name)
                ? `latest · ${formatDate(latestIn(category.name)!.data.pubDatetime)}`
                : "no articles yet"}
            </p>
          </article>
        ))
      }
    </div>

    <p class="text-subtle mt-10 font-mono text-[0.7rem]">
      Looking for a single tag instead?
      <a href="/tags" class="link">Browse all {tags.length} tags</a>
      <ArrowRight size={11} class="ml-1 inline" />
    </p>
  </section>
</BaseLayout>
