---
/**
 * Root entry point. Sends first-time visitors to the default locale (English)
 * and returning visitors to whichever language they last chose. Kept as a tiny
 * static page so it works on any host, with canonical/hreflang signals pointing
 * search engines at the real locale URLs.
 */
import { DEFAULT_LOCALE, LOCALE_META, LOCALES } from "@/i18n/config";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/ui";

const t = useTranslations(DEFAULT_LOCALE);
const origin = Astro.site ?? new URL(SITE.url);
const target = new URL(`/${DEFAULT_LOCALE}/`, origin).href;
---

<!doctype html>
<html lang={LOCALE_META[DEFAULT_LOCALE].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title} — {t("site.tagline")}</title>
    <meta name="description" content={t("site.description")} />
    <link rel="canonical" href={target} />
    {
      LOCALES.map((code) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[code].htmlLang}
          href={new URL(`/${code}/`, origin).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={target} />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LOCALE}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        let stored = null;
        try {
          stored = localStorage.getItem("jg-locale");
        } catch {
          stored = null;
        }
        const target = stored === "vi" ? "/vi/" : "/en/";
        location.replace(target);
      })();
    </script>
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: #1a1b26;
        color: #c0caf5;
        font-family: "Inter", system-ui, sans-serif;
      }
      a {
        color: #7aa2f7;
      }
      p {
        font-size: 0.9rem;
        line-height: 1.6;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <p>
      <a href="/en/">English</a> · <a href="/vi/">Tiếng Việt</a>
    </p>
  </body>
</html>
