---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/utils/posts";
import { formatDate } from "@/utils/slug";
import { SITE } from "@/config";

const posts = await getPosts();

const years = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDatetime.getFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}
const ordered = [...years.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout
  title="Archive"
  description={`The complete archive of ${posts.length} articles on ${SITE.title}, from ${posts[posts.length - 1]?.data.pubDatetime.getFullYear()} to ${posts[0]?.data.pubDatetime.getFullYear()}.`}
>
  <section class="shell pt-12 pb-8 md:pt-16">
    <p class="eyebrow">Archive</p>
    <h1 class="display-lg mt-4">Everything, by year.</h1>
    <p class="text-muted mt-4 max-w-[36rem] text-[0.95rem] leading-relaxed">
      {posts.length} entries across {ordered.length} years — the whole journal, in reverse order.
    </p>
  </section>

  <section class="shell pb-20">
    {
      ordered.map(([year, entries]) => (
        <div class="mb-12">
          <div class="mb-3 flex items-baseline gap-4">
            <h2 class="font-display text-primary/90 text-3xl font-bold tracking-[-0.03em]">
              {year}
            </h2>
            <span class="bg-line h-px flex-1" />
            <span class="text-subtle font-mono text-[0.62rem]">{entries.length} posts</span>
          </div>

          <ul class="border-line border-b">
            {entries.map((post) => {
              return (
                <li>
                  <a
                    href={`/posts/${post.id}`}
                    class="group border-line hover:bg-sunken/40 grid grid-cols-[4.2rem_1fr] items-baseline gap-3 border-t py-2.5 transition-colors sm:grid-cols-[5rem_1fr_9rem]"
                  >
                    <time
                      datetime={post.data.pubDatetime.toISOString()}
                      class="text-subtle font-mono text-[0.65rem]"
                    >
                      {formatDate(post.data.pubDatetime).slice(0, 6)}
                    </time>
                    <span class="font-display group-hover:text-primary text-[0.98rem] leading-snug font-medium tracking-[-0.01em] transition-colors">
                      {post.data.title}
                    </span>
                    <span class="text-subtle hidden justify-self-end font-mono text-[0.62rem] sm:block">
                      {post.data.category}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
