---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowLeft, Compass } from "@lucide/astro";
import { DEFAULT_LOCALE } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

const t = useTranslations(DEFAULT_LOCALE);
const tvi = useTranslations("vi");
---

<BaseLayout
  title={t("notfound.heading")}
  description={t("notfound.body")}
  locale={DEFAULT_LOCALE}
  noindex
  route="/404"
>
  <section class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="text-primary/80 font-mono text-[0.7rem] tracking-[0.18em] uppercase">
      {t("notfound.code")}
    </p>
    <h1 class="display-xl mt-4 max-w-[22ch]">
      404<span class="text-accent">.</span><br />
      <span class="text-muted">{t("notfound.heading")}</span>
    </h1>
    <p class="text-muted mt-5 max-w-[36rem] text-[0.95rem] leading-relaxed">{t("notfound.body")}</p>
    <p class="text-subtle mt-2 max-w-[36rem] text-[0.9rem] leading-relaxed" lang="vi">
      {tvi("notfound.body")}
    </p>
    <div class="mt-8 flex flex-wrap gap-2.5">
      <a href="/en/posts/" class="btn btn--primary">
        <ArrowLeft size={13} stroke-width={2} />
        {t("notfound.back")}
      </a>
      <a href="/vi/posts/" class="btn">
        <ArrowLeft size={13} stroke-width={2} />
        {tvi("notfound.back")}
      </a>
      <a href="/en/categories/" class="btn btn--ghost">
        <Compass size={13} stroke-width={2} />
        {t("notfound.topics")}
      </a>
    </div>
  </section>
</BaseLayout>
