---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowLeft, Compass } from "@lucide/astro";
---

<BaseLayout title="Not found" description="That page does not exist." noindex>
  <section class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="text-primary/80 font-mono text-[0.7rem] tracking-[0.18em] uppercase">Error 404</p>
    <h1 class="display-xl mt-4 max-w-[20ch]">
      Dead link.<br /><span class="text-muted">Wrong terminal.</span>
    </h1>
    <p class="text-muted mt-5 max-w-[36rem] text-[0.95rem] leading-relaxed">
      The URL you followed does not exist — it may have moved during the migration from Viblo. The
      journal, the topic index and full-text search are all still here.
    </p>
    <div class="mt-8 flex flex-wrap gap-2.5">
      <a href="/posts" class="btn btn--primary">
        <ArrowLeft size={13} stroke-width={2} />
        Back to the journal
      </a>
      <a href="/categories" class="btn">
        <Compass size={13} stroke-width={2} />
        Browse topics
      </a>
      <button type="button" class="btn btn--ghost" data-search-open>Search instead</button>
    </div>
  </section>
</BaseLayout>
