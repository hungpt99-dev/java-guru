---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowUpRight, MapPin, Rss } from "@lucide/astro";
import { SITE } from "@/config";
import { getPosts, getCategories, articleCount } from "@/utils/posts";
import { formatDate, localePath } from "@/utils/i18n";
import { LOCALES, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const posts = await getPosts(locale);
const categories = getCategories(posts, locale);
const count = await articleCount();
const first = posts[posts.length - 1];
const latest = posts[0];

const stack = ["Java", "Spring Boot", "Kafka", "Redis", "PostgreSQL", "Astro", "TypeScript"];

const principles = {
  en: [
    {
      title: "Write from production, not from slides",
      body: "Most essays start with something that broke: a retry storm, a shutdown that never happened, a config line nobody remembered. The theory comes after the incident.",
    },
    {
      title: "Trade-offs over verdicts",
      body: "Microservices, monoliths, virtual threads, agents: the interesting part is never the choice itself, it is the cost you accept when you make it.",
    },
    {
      title: "Keep the code as it ran",
      body: "Examples stay exactly as they were used, comments included. A snippet cleaned up for presentation teaches the wrong lesson.",
    },
  ],
  vi: [
    {
      title: "Viết từ production, không phải từ slide",
      body: "Phần lớn bài bắt đầu từ một thứ đã hỏng: bão retry, một lần shutdown không bao giờ xảy ra, một dòng config không ai nhớ. Lý thuyết đến sau sự cố.",
    },
    {
      title: "Đánh đổi thay vì phán xét",
      body: "Microservices, monolith, virtual threads, agent: phần thú vị không phải lựa chọn, mà là cái giá bạn chấp nhận khi chọn.",
    },
    {
      title: "Giữ nguyên code như lúc chạy",
      body: "Ví dụ được giữ đúng như khi dùng, kể cả comment. Một snippet đã dọn cho đẹp sẽ dạy sai bài học.",
    },
  ],
}[locale];
---

<BaseLayout
  title={t("about.title")}
  description={`${SITE.author.name} (${SITE.author.handle}) — ${t("site.description")}`}
  locale={locale}
  route="/about/"
>
  <section class="shell pt-12 pb-10 md:pt-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_16rem] lg:gap-16">
      <div class="max-w-[44rem]">
        <p class="eyebrow">{t("about.title")}</p>
        <h1 class="display-lg mt-4">
          {t("about.headingLead", { name: SITE.author.name })} —<br />
          <span class="text-muted">{t("about.headingAccent")}</span>
        </h1>

        <div class="text-muted mt-7 space-y-4 text-[1rem] leading-relaxed">
          <p><span class="text-fg">{t("about.role")}</span></p>
          <p>
            {
              t("about.body1", {
                intro: t("home.intro"),
                bio: t("home.bio"),
              })
            }
          </p>
          <p>
            {
              t("about.body2", {
                count,
                topics: categories.length,
                since: first ? formatDate(first.data.pubDate, locale) : "",
                latest: latest ? formatDate(latest.data.pubDate, locale) : "",
              })
            }
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
          {stack.map((item) => <span class="chip chip--neutral">{item}</span>)}
        </div>
      </div>

      <aside class="lg:pt-2">
        <img
          src={SITE.author.avatar}
          alt={SITE.author.name}
          width="320"
          height="320"
          class="border-line aspect-square w-full max-w-[11rem] rounded-xl border object-cover"
        />
        <dl class="mt-5 space-y-2 font-mono text-[0.68rem]">
          <div class="border-line flex justify-between gap-3 border-b pb-2">
            <dt class="text-subtle">handle</dt>
            <dd class="text-muted">{SITE.author.handle}</dd>
          </div>
          <div class="border-line flex justify-between gap-3 border-b pb-2">
            <dt class="text-subtle">alias</dt>
            <dd class="text-muted">{SITE.author.alias}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-subtle">{locale === "vi" ? "ở" : "based in"}</dt>
            <dd class="text-muted flex items-center gap-1">
              <MapPin size={10} stroke-width={2} />
              {SITE.author.location[locale]}
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="shell pb-12">
    <div class="hairline pt-8">
      <p class="eyebrow">{t("about.approach")}</p>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {
          principles.map((principle) => (
            <div class="panel p-5">
              <h2 class="font-display text-[1.02rem] font-semibold tracking-[-0.01em]">
                {principle.title}
              </h2>
              <p class="text-muted mt-2 text-[0.86rem] leading-relaxed">{principle.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="shell pb-20">
    <div class="hairline grid gap-8 pt-8 md:grid-cols-2">
      <div>
        <p class="eyebrow">{t("about.paths")}</p>
        <ul class="mt-4 space-y-2">
          {
            categories.slice(0, 5).map((category) => (
              <li>
                <a
                  href={localePath(locale, `/categories/${category.slug}/`)}
                  class="group border-line flex items-baseline justify-between gap-4 border-b py-2"
                >
                  <span class="text-muted group-hover:text-primary text-[0.92rem] transition-colors">
                    {category.label}
                  </span>
                  <span class="text-subtle font-mono text-[0.62rem]">{category.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow">{t("about.elsewhere")}</p>
        <ul class="mt-4 space-y-2">
          {
            SITE.socials.map((social) => (
              <li>
                <a
                  href={social.local ? localePath(locale, social.href) : social.href}
                  target={social.local ? undefined : "_blank"}
                  rel="me noopener noreferrer"
                  class="group border-line flex items-center justify-between gap-4 border-b py-2"
                >
                  <span class="text-muted group-hover:text-primary text-[0.92rem] transition-colors">
                    {social.label}
                  </span>
                  <ArrowUpRight
                    size={12}
                    stroke-width={2}
                    class="text-subtle group-hover:text-primary"
                  />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="text-subtle mt-6 flex items-center gap-2 font-mono text-[0.62rem]">
          <Rss size={11} stroke-width={2} />
          <a href={localePath(locale, "/rss.xml")} class="hover:text-primary">{t("about.feed")}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
