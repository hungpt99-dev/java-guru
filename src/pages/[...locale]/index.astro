---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/blog/PostCard.astro";
import PostRow from "@/components/blog/PostRow.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import ProjectCard from "@/components/common/ProjectCard.astro";
import { ArrowRight, ArrowUpRight, Terminal, Boxes } from "@lucide/astro";
import { SITE } from "@/config";
import { LOCALES, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import {
  getPosts,
  getCategories,
  getTags,
  featuredPosts,
  totalReadingMinutes,
} from "@/utils/posts";
import { PROJECTS } from "@/data/projects";
import { formatDate, localePath } from "@/utils/i18n";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const posts = await getPosts(locale);
const categories = getCategories(posts, locale);
const tags = getTags(posts);
const featured = featuredPosts(posts, SITE.featuredOnHome);
const latest = posts.filter((post) => !featured.includes(post)).slice(0, 6);
const hours = Math.round(totalReadingMinutes(posts) / 60);
const featuredProjects = PROJECTS.filter((p) => p.featured).slice(0, 3);
const homelabPost = posts.find((p) => p.data.category === "DevOps & Infrastructure");
const oldest = posts[posts.length - 1];

const stats = [
  { value: String(posts.length), label: t("home.stats.essays") },
  { value: String(categories.length), label: t("home.stats.topics") },
  { value: String(tags.length), label: t("home.stats.tags") },
  { value: `${hours}h`, label: t("home.stats.reading") },
];
---

<BaseLayout title={SITE.title} description={t("site.description")} locale={locale} route="/">
  <!-- ── hero ─────────────────────────────────────────────────────────── -->
  <section class="hero-glow relative overflow-hidden">
    <div class="dot-grid"></div>
    <div class="shell relative z-10 pt-12 pb-10 md:pt-20 md:pb-14">
      <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-16">
        <div class="max-w-[46rem]">
          <p class="eyebrow">{t("home.eyebrow")}</p>

          <h1 class="display-xl mt-6">
            {t("home.greeting", { name: SITE.author.givenName })}
            <span class="text-accent">—</span>
          </h1>

          <p class="text-muted mt-5 max-w-[40rem] text-[1.12rem] leading-[1.65] md:text-[1.28rem]">
            {t("home.intro")}
          </p>

          <p class="text-subtle mt-4 max-w-[38rem] text-[0.95rem] leading-relaxed">
            {t("home.bio")}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-2.5">
            <a href={localePath(locale, "/posts/")} class="btn btn--primary">
              {t("home.cta.journal")}
              <ArrowRight size={14} stroke-width={2} />
            </a>
            <a href={localePath(locale, "/about/")} class="btn">{t("home.cta.about")}</a>
            <a
              href={SITE.socials[0].href}
              class="btn btn--ghost"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("home.cta.github")}
              <ArrowUpRight size={13} stroke-width={2} />
            </a>
          </div>

          <div class="text-subtle mt-9 flex items-center gap-3 font-mono text-[0.65rem]">
            <span class="relative flex h-1.5 w-1.5">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--cat-devops)] opacity-60"
              ></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--cat-devops)]"
              ></span>
            </span>
            <span>
              {
                oldest
                  ? t("home.writingSince", { date: formatDate(oldest.data.pubDate, locale) })
                  : ""
              }
            </span>
            <span class="opacity-40">/</span>
            <span>{SITE.author.handle}</span>
          </div>
        </div>

        <div class="order-first lg:order-none">
          <div class="relative mx-auto w-full max-w-[15rem] lg:max-w-none">
            <div class="absolute -inset-3 rounded-[1.4rem] bg-[var(--signal)] opacity-15 blur-xl">
            </div>
            <div class="panel relative overflow-hidden !rounded-2xl p-2">
              <img
                src={SITE.author.avatar}
                alt={SITE.author.name}
                width="420"
                height="420"
                class="aspect-square w-full rounded-xl object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div
              class="text-subtle mt-3 flex items-baseline justify-between font-mono text-[0.62rem]"
            >
              <span class="text-muted">{SITE.author.name}</span>
              <span>{SITE.author.alias}</span>
            </div>
          </div>
        </div>
      </div>

      <dl
        class="border-line bg-line mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-xl border sm:grid-cols-4"
      >
        {
          stats.map((stat) => (
            <div class="bg-bg px-4 py-4">
              <dt class="text-subtle font-mono text-[0.6rem] tracking-[0.14em] uppercase">
                {stat.label}
              </dt>
              <dd class="font-display mt-1 text-2xl font-bold tracking-tight">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── featured ─────────────────────────────────────────────────────── -->
  <section class="shell py-14 md:py-16">
    <SectionHeader
      index="01"
      label={t("home.featured.label")}
      title={t("home.featured.title")}
      href={localePath(locale, "/posts/")}
      linkLabel={`${t("common.all")} ${posts.length}`}
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((post, i) => <PostCard post={post} priority={i === 0} />)}
    </div>
  </section>

  <!-- ── latest ───────────────────────────────────────────────────────── -->
  <section class="shell py-10 md:py-12">
    <SectionHeader
      index="02"
      label={t("home.latest.label")}
      title={t("home.latest.title")}
      href={localePath(locale, "/posts/")}
      linkLabel={t("home.latest.link")}
    />
    <div class="border-line border-b">
      {latest.map((post, i) => <PostRow post={post} index={i} />)}
    </div>
  </section>

  <!-- ── topics ───────────────────────────────────────────────────────── -->
  <section class="shell py-14 md:py-16">
    <SectionHeader
      index="03"
      label={t("home.topics.label")}
      title={t("home.topics.title")}
      href={localePath(locale, "/categories/")}
      linkLabel={t("home.topics.link")}
    />
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => (
          <a
            href={localePath(locale, `/categories/${category.slug}/`)}
            class:list={["topic-tile", `cat-${category.accent}`]}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-fg text-[1.02rem] font-semibold tracking-[-0.01em]">
                {category.label}
              </h3>
              <span class="text-subtle font-mono text-[0.62rem]">
                {String(category.count).padStart(2, "0")}
              </span>
            </div>
            <p class="text-subtle line-clamp-2 text-[0.82rem] leading-relaxed">{category.blurb}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ── projects ─────────────────────────────────────────────────────── -->
  <section class="shell py-10 md:py-12">
    <SectionHeader
      index="04"
      label={t("home.projects.label")}
      title={t("home.projects.title")}
      href={localePath(locale, "/projects/")}
      linkLabel={t("home.projects.link")}
    />
    <div class="grid gap-4 md:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </section>

  <!-- ── homelab ──────────────────────────────────────────────────────── -->
  <section class="shell py-14 md:py-20">
    <SectionHeader
      index="05"
      label={t("home.homelab.label")}
      title={t("home.homelab.title")}
      href={localePath(locale, "/homelab/")}
      linkLabel={t("home.homelab.link")}
    />
    <div class="panel relative overflow-hidden">
      <div class="grid gap-8 p-6 md:grid-cols-[1.2fr_1fr] md:p-8">
        <div>
          <p class="text-muted max-w-[34rem] text-[0.98rem] leading-relaxed">
            {t("home.homelab.body")}
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={localePath(locale, "/homelab/")} class="btn btn--primary">
              <Boxes size={13} stroke-width={2} />
              {t("home.homelab.cta")}
            </a>
            {
              homelabPost && (
                <a href={localePath(locale, `/posts/${homelabPost.data.slug}/`)} class="btn">
                  {t("home.homelab.buildLog")}
                  <ArrowUpRight size={12} stroke-width={2} />
                </a>
              )
            }
          </div>
        </div>

        <div
          class="border-line bg-sunken/70 text-subtle rounded-lg border p-4 font-mono text-[0.68rem] leading-relaxed"
        >
          <p class="mb-3 flex items-center gap-2 text-[0.6rem] tracking-[0.14em] uppercase">
            <Terminal size={12} stroke-width={2} class="text-primary" />
            ~/homelab
          </p>
          <p><span class="text-primary">$</span> whoami</p>
          <p class="text-muted">hung@selfhosted</p>
          <p class="mt-2"><span class="text-primary">$</span> ls services/</p>
          <p class="text-muted">reverse-proxy/ · monitoring/ · backups/ · …</p>
          <p class="mt-2"><span class="text-primary">$</span> cat status</p>
          <p class="text-muted">
            {
              locale === "vi"
                ? "ghi chép dần theo lúc dựng — xem trang homelab để biết phần nào đã thật."
                : "documented as it is built — see the lab page for what is real."
            }
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
