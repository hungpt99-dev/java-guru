---
import { Link2, Check } from "@lucide/astro";
import { type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

export interface Props {
  title: string;
  url: string;
  locale: Locale;
}

const { title, url, locale } = Astro.props;
const t = useTranslations(locale);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const targets = [
  { label: "X", href: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}` },
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
];
---

<div class="flex flex-wrap items-center gap-2">
  <span class="label-mono mr-1">{t("article.share")}</span>
  {
    targets.map((target) => (
      <a
        href={target.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn !min-h-8 !px-2.5 !text-[0.65rem]"
      >
        {target.label}
      </a>
    ))
  }
  <button
    type="button"
    class="btn !min-h-8 !px-2.5 !text-[0.65rem]"
    data-copy-link
    data-url={url}
    data-copied-label={t("article.copied")}
    data-default-label={t("article.copyLink")}
  >
    <Link2 size={12} stroke-width={2} data-copy-icon="link" />
    <Check
      size={12}
      stroke-width={2}
      class="hidden text-[var(--cat-devops)]"
      data-copy-icon="done"
    />
    <span data-copy-label>{t("article.copyLink")}</span>
  </button>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  button?.addEventListener("click", async () => {
    const url = button.dataset.url ?? window.location.href;
    const label = button.querySelector("[data-copy-label]");
    const copied = button.dataset.copiedLabel ?? "Copied";
    const original = button.dataset.defaultLabel ?? "Copy link";
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = copied;
      button.querySelector('[data-copy-icon="link"]')?.classList.add("hidden");
      button.querySelector('[data-copy-icon="done"]')?.classList.remove("hidden");
      setTimeout(() => {
        if (label) label.textContent = original;
        button.querySelector('[data-copy-icon="link"]')?.classList.remove("hidden");
        button.querySelector('[data-copy-icon="done"]')?.classList.add("hidden");
      }, 1800);
    } catch {
      if (label) label.textContent = "⌘C";
    }
  });
</script>
