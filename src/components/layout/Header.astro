---
import { Search, Menu, X } from "@lucide/astro";
import { SITE, THEMES } from "@/config";
import ThemePicker from "@/components/navigation/ThemePicker.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header
  class="border-line sticky top-0 z-50 border-b bg-[color-mix(in_oklab,var(--bg)_86%,transparent)] backdrop-blur-md"
>
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-baseline gap-2.5" aria-label={`${SITE.title} — home`}>
      <span class="text-primary/70 group-hover:text-primary font-mono text-xs transition">~/</span>
      <span class="font-display text-[1.05rem] font-extrabold tracking-[-0.03em]">
        java<span class="text-primary">guru</span>
      </span>
      <span class="text-subtle hidden font-mono text-[0.6rem] tracking-[0.16em] uppercase sm:inline"
        >journal</span
      >
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-md px-2.5 py-1.5 font-mono text-[0.75rem] transition-colors",
              isActive(item.href) ? "text-primary" : "text-muted hover:text-fg",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        class="btn btn--ghost !min-h-9 !px-2.5"
        data-search-open
        aria-label="Search articles"
        aria-keyshortcuts="k"
      >
        <Search size={15} stroke-width={1.75} />
        <span class="text-subtle hidden font-mono text-[0.65rem] lg:inline">⌘K</span>
      </button>

      <ThemePicker themes={THEMES} />

      <button
        type="button"
        class="btn btn--ghost !min-h-9 !px-2.5 md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Menu size={17} stroke-width={1.75} data-menu-icon="open" />
        <X size={17} stroke-width={1.75} data-menu-icon="close" class="hidden" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="shell border-line hidden border-t pb-4 md:hidden" data-menu-panel>
    <nav class="mobile-nav" aria-label="Mobile">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="/archives">Archive</a>
      <a href="/search">Search</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector('[data-menu-icon="open"]')?.classList.toggle("hidden", open);
      toggle.querySelector('[data-menu-icon="close"]')?.classList.toggle("hidden", !open);
    });
  }
</script>
