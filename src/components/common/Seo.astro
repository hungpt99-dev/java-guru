---
import { SITE } from "@/config";
import { LOCALE_META, LOCALES, type Locale } from "@/i18n/config";
import { localePath } from "@/utils/i18n";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Root-relative or absolute image path. */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Unprefixed route ("/posts/" or "/posts/<slug>/") used for alternates. */
  route: string;
}

const {
  title,
  description,
  locale,
  image = "/images/og-default.png",
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  jsonLd,
  route,
} = Astro.props;

const origin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(localePath(locale, route), origin).href;
const absoluteImage = new URL(image, origin).href;
const fullTitle = title === SITE.title ? `${SITE.title}` : `${title} · ${SITE.title}`;

const alternates = LOCALES.map((code) => ({
  hreflang: LOCALE_META[code].htmlLang,
  href: new URL(localePath(code, route), origin).href,
}));

const graph = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(localePath("en", route), origin).href} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{
  LOCALES.filter((code) => code !== locale).map((code) => (
    <meta property="og:locale:alternate" content={LOCALE_META[code].ogLocale} />
  ))
}
{
  type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{
  type === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )
}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

{
  LOCALES.map((code) => (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — ${LOCALE_META[code].label}`}
      href={new URL(localePath(code, "/rss.xml"), origin).href}
    />
  ))
}
<link rel="sitemap" href="/sitemap-index.xml" />

{graph.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
