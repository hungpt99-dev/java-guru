---
import { ArrowRight } from "@lucide/astro";

export interface Props {
  index?: string;
  label: string;
  title?: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}

const { index, label, title, href, linkLabel = "all", class: className } = Astro.props;
---

<div class:list={["mb-5 flex flex-wrap items-end justify-between gap-3", className]}>
  <div>
    <p class="eyebrow">
      {index && <span class="text-primary/80">{index}</span>}
      <span>{label}</span>
    </p>
    {
      title && (
        <h2 class="font-display mt-2 text-[1.6rem] leading-tight font-bold tracking-[-0.025em]">
          {title}
        </h2>
      )
    }
  </div>
  {
    href && (
      <a href={href} class="arrow-link">
        {linkLabel}
        <ArrowRight size={13} stroke-width={2} />
      </a>
    )
  }
</div>
