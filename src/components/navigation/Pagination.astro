---
import { ChevronLeft, ChevronRight } from "@lucide/astro";

export interface Props {
  current: number;
  total: number;
  /** Route stem, e.g. "/posts" — page 1 is the stem itself. */
  base: string;
}

const { current, total, base } = Astro.props;
const href = (page: number) => (page <= 1 ? base + "/" : `${base}/${page}/`);

const windowSize = 2;
const pages: Array<number | "gap"> = [];
for (let i = 1; i <= total; i++) {
  if (i === 1 || i === total || Math.abs(i - current) <= windowSize) pages.push(i);
  else if (pages[pages.length - 1] !== "gap") pages.push("gap");
}
---

{
  total > 1 && (
    <nav
      class="border-line mt-12 flex items-center justify-between gap-4 border-t pt-6"
      aria-label="Pagination"
    >
      {current > 1 ? (
        <a href={href(current - 1)} class="btn" rel="prev">
          <ChevronLeft size={14} stroke-width={2} />
          Previous
        </a>
      ) : (
        <span class="btn pointer-events-none opacity-35" aria-hidden="true">
          <ChevronLeft size={14} stroke-width={2} />
          Previous
        </span>
      )}

      <div class="hidden items-center gap-1 font-mono text-[0.7rem] sm:flex">
        {pages.map((entry) =>
          entry === "gap" ? (
            <span class="text-subtle px-1.5">…</span>
          ) : (
            <a
              href={href(entry)}
              class:list={[
                "min-w-7 rounded px-2 py-1 text-center transition-colors",
                entry === current ? "bg-primary/15 text-primary" : "text-muted hover:text-fg",
              ]}
              aria-current={entry === current ? "page" : undefined}
            >
              {entry}
            </a>
          )
        )}
      </div>

      {current < total ? (
        <a href={href(current + 1)} class="btn" rel="next">
          Next
          <ChevronRight size={14} stroke-width={2} />
        </a>
      ) : (
        <span class="btn pointer-events-none opacity-35" aria-hidden="true">
          Next
          <ChevronRight size={14} stroke-width={2} />
        </span>
      )}
    </nav>
  )
}
