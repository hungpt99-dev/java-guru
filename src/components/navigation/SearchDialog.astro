---
import { Search } from "@lucide/astro";
---

<div class="search-panel" data-search-root hidden>
  <div class="search-box" role="dialog" aria-modal="true" aria-label="Search the journal">
    <div class="border-line flex items-center gap-2 border-b px-3">
      <Search size={15} stroke-width={1.75} class="text-subtle shrink-0" />
      <input
        type="search"
        class="search-input !border-0"
        placeholder="Search articles, topics, tags…"
        aria-label="Search articles"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button type="button" class="btn btn--ghost !min-h-7 !px-2 !text-[0.6rem]" data-search-close
        >esc</button
      >
    </div>
    <div class="search-results" data-search-results role="listbox" aria-label="Results">
      <p class="text-subtle px-3 py-6 text-center font-mono text-[0.7rem]">
        Search runs on a static index built at deploy time.
      </p>
    </div>
    <div
      class="border-line text-subtle flex items-center justify-between border-t px-3 py-2 font-mono text-[0.6rem]"
    >
      <span>↑↓ to navigate · ↵ to open</span>
      <a href="/search" class="hover:text-primary">all results →</a>
    </div>
  </div>
</div>

<script>
  type PagefindResult = {
    data: () => Promise<{
      url: string;
      excerpt: string;
      meta: { title?: string };
      raw_url?: string;
    }>;
  };
  type Pagefind = {
    options: (opts: Record<string, unknown>) => void;
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  };

  const panel = document.querySelector<HTMLElement>("[data-search-root]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const results = document.querySelector<HTMLElement>("[data-search-results]");
  const openers = [...document.querySelectorAll<HTMLElement>("[data-search-open]")];
  const closers = [...document.querySelectorAll<HTMLElement>("[data-search-close]")];

  let pagefind: Pagefind | null = null;
  let loadError: string | null = null;
  let selected = -1;
  let hits: HTMLElement[] = [];

  const load = async () => {
    if (pagefind || loadError) return pagefind;
    try {
      // Pagefind writes this bundle into dist/ at build time; it is not part of
      // the dev server, where the catch below shows a friendly hint instead.
      const pfUrl = "/pagefind/pagefind.js";
      const mod = await import(/* @vite-ignore */ pfUrl);
      pagefind = (mod.default ?? mod) as Pagefind;
      pagefind.options({ excerptLength: 22 });
    } catch {
      loadError =
        "The search index is generated by `pnpm build`. Run a production build to search locally.";
    }
    return pagefind;
  };

  const message = (text: string) => {
    if (!results) return;
    results.innerHTML = `<p class="px-3 py-6 text-center font-mono text-[0.7rem] text-subtle">${text}</p>`;
    hits = [];
    selected = -1;
  };

  const render = async (query: string) => {
    const pf = await load();
    if (!pf) return message(loadError ?? "Search is unavailable.");
    if (query.trim().length < 2) return message("Type at least two characters.");
    const search = await pf.search(query);
    const top = search.results.slice(0, 8);
    if (!top.length) return message(`No results for “${query}”.`);
    const data = await Promise.all(top.map((r) => r.data()));
    if (!results) return;
    results.innerHTML = "";
    hits = data.map((item) => {
      const a = document.createElement("a");
      a.className = "search-hit";
      a.href = item.url;
      a.setAttribute("role", "option");
      a.innerHTML = `<h4>${item.meta.title ?? "Untitled"}</h4><p>${item.excerpt}</p>`;
      return a;
    });
    for (const hit of hits) results.appendChild(hit);
    selected = -1;
  };

  const open = () => {
    if (!panel) return;
    panel.hidden = false;
    document.body.style.overflow = "hidden";
    input?.focus();
    input?.select();
  };

  const close = () => {
    if (!panel) return;
    panel.hidden = true;
    document.body.style.overflow = "";
  };

  const highlight = (next: number) => {
    if (!hits.length) return;
    selected = (next + hits.length) % hits.length;
    hits.forEach((hit, i) => hit.setAttribute("aria-selected", String(i === selected)));
    hits[selected]?.scrollIntoView({ block: "nearest" });
  };

  for (const opener of openers) opener.addEventListener("click", open);
  for (const closer of closers) closer.addEventListener("click", close);
  panel?.addEventListener("click", (event) => {
    if (event.target === panel) close();
  });

  let timer: number | undefined;
  input?.addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => void render(input.value), 180);
  });

  document.addEventListener("keydown", (event) => {
    const isTypingTarget =
      event.target instanceof HTMLElement &&
      ["INPUT", "TEXTAREA", "SELECT"].includes(event.target.tagName);

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (panel?.hidden) open();
      else close();
      return;
    }
    if (panel?.hidden) return;
    if (event.key === "Escape") {
      event.preventDefault();
      close();
    }
    if (event.key === "ArrowDown") {
      event.preventDefault();
      highlight(selected + 1);
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      highlight(selected - 1);
    }
    if (event.key === "Enter" && selected >= 0) {
      event.preventDefault();
      hits[selected]?.click();
    }
    if (event.key === "/" && !isTypingTarget) {
      event.preventDefault();
      open();
    }
  });
</script>
